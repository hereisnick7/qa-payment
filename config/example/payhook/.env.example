# pay-hook — synthetic signed provider webhooks (qa-payment-agent).
# No secrets here: signing keys are read from the backend repo config at the MR ref at runtime.

# Default stand to target (can be overridden with --host=).
PAYHOOK_HOST=https://dev.example.com
# Comma-separated NON-PROD hosts pay-hook may target. Never add production.
PAYHOOK_ALLOWED_HOSTS=dev.example.com

# HighHelp adapter: where the backend keeps its HighHelp config.
PAYHOOK_HIGHHELP_REPO=example-backend
PAYHOOK_HIGHHELP_CONFIG=config/default.yaml
